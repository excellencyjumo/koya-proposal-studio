# ==============================================================================
# Koya Proposal Studio - Environment Configuration Template
# All production secrets must be supplied via secure environment variables.
# ==============================================================================

# Server Port (default 3000)
PORT=3000

# Application Base URL (Required for Slack buttons, emails, and client portals)
APP_BASE_URL=https://koya-proposal-studio.onrender.com
PUBLIC_APP_URL=https://koya-proposal-studio.onrender.com

# Anthropic Claude API Key (Required for proposal generation)
ANTHROPIC_API_KEY=

# Anthropic Claude Model Identifier (e.g. claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Storage Driver (supabase | local)
STORAGE_DRIVER=local

# Supabase Cloud Database URL (Required when STORAGE_DRIVER=supabase)
SUPABASE_URL=

# Supabase Service Role Key (Required when STORAGE_DRIVER=supabase)
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret Key for Session Token Signing (Required)
JWT_SECRET=

# Password for Seeded Sales Rep Account (sarah.chen@koyatalent.com)
SALES_PASSWORD=

# Password for Seeded Sales Manager Account (marcus.vance@koyatalent.com)
MANAGER_PASSWORD=

# Slack Incoming Webhook URL for Block Kit notifications (Optional)
SLACK_WEBHOOK_URL=

# Demo Mode (true | false). When true, enables quick-fill credentials in UI.
DEMO_MODE=true

# Allowed Origin for CORS
ALLOWED_ORIGIN=*
