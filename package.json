{
  "name": "koya-proposal-studio-nestjs",
  "version": "1.0.0",
  "description": "Enterprise NestJS & TypeScript AI Proposal Studio with Claude Haiku 4.5, Terminus Observability, Real Bcrypt Auth, and Four-Eyes Governance",
  "scripts": {
    "build": "npm --prefix client run build && node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "build:server": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "build:client": "npm --prefix client run build",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/terminus": "^10.2.3",
    "@supabase/supabase-js": "^2.49.1",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
